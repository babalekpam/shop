{
  "name": "argilette-shop",
  "version": "0.1.0",
  "private": true,
  "description": "ARGILETTE.shop — storefront and entitlement backbone",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm run test && npm run build"
  },
  "comments": {
    "pinning": "Exact versions, no ranges, lockfile committed — security spec §11. A checkout path is not the place for a floating dependency."
  },
  "dependencies": {
    "motion": "13.1.0",
    "next": "16.3.1",
    "next-intl": "4.13.6",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "jsdom": "30.0.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}

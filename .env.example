# ARGILETTE.shop — environment
#
# Copy to `.env.local` and fill in. Never commit a filled-in copy: secrets live in a
# managed secret store and are injected at runtime (security spec §9). The repository
# history is scanned, and a leaked gateway key is a same-day rotation.
#
# The app RUNS with none of these set. The catalog, all ten locales, the cart and the
# design system work without any credential. Checkout returns a clear 501 until the
# gateway keys below are present — deliberately, so a half-configured deploy cannot look
# like a working one.

# ---- Public ----------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://argilette.shop
NEXT_PUBLIC_DEFAULT_LOCALE=en

# ---- Database (Sprint 1) ---------------------------------------------------------
# Neon Postgres. The app connects with a role that cannot DROP, cannot read the audit
# log, and cannot alter schema (security spec §4).
DATABASE_URL=

# ---- Identity (Sprint 1) ---------------------------------------------------------
# Existing Keycloak instance. Authorization Code flow with PKCE only — no implicit, no
# ROPC. Separate client per product, non-overlapping scopes.
KEYCLOAK_ISSUER=
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=

# ---- Paddle — international (Sprint 3) -------------------------------------------
# Merchant of record. Hosts its own payment fields; no card data reaches us.
PADDLE_API_KEY=
PADDLE_CLIENT_TOKEN=
PADDLE_WEBHOOK_SECRET=
PADDLE_ENV=sandbox

# ---- CinetPay — mobile money (Sprint 4) ------------------------------------------
# Orange Money, MTN, Moov, Wave. Notifications MUST be re-verified server-side against
# CinetPay's check endpoint before anything is granted.
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
CINETPAY_SECRET_KEY=

# ---- FX (Sprint 2) ---------------------------------------------------------------
# One snapshot per day, written to fx_rates. If the latest snapshot is older than 48
# hours, freeze prices at the last good rate and alert ops — never fall back to a live
# call, never serve a stale-but-unflagged rate.
FX_PROVIDER_API_KEY=
FX_REFRESH_CRON=0 3 * * *

# ---- Email (Sprint 3) ------------------------------------------------------------
SMTP_HOST=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@argilette.shop

# ---- Entitlement API (Sprint 5) --------------------------------------------------
# JSON map of product_slug -> hashed token. Per-product, independently revocable,
# rotated quarterly.
ENTITLEMENT_SERVICE_TOKENS={}

# ---- Node CRM — agency system of record (agency spec §5) -------------------------
# The agency runs without these, falling back to its local store. Set both to connect.
# Verify with: npm run agency:crm-check
NODE_CRM_URL=
NODE_CRM_TOKEN=
# Optional JSON overriding endpoint paths and field names when Node CRM's shape differs
# from the defaults in src/agency/crm/mapping.ts. Example:
#   {"fields":{"organisation":"company_name"},"endpoints":{"listContacts":"/contacts"}}
NODE_CRM_MAPPING=

# ---- Agency outbound (agency spec §4.1) -----------------------------------------
# MUST be a different domain from MAIL_FROM above. Degraded outreach reputation would
# otherwise stop licence keys reaching paying customers. Startup refuses if they match.
AGENCY_MAIL_FROM=
AGENCY_SMTP_HOST=
AGENCY_SMTP_USER=
AGENCY_SMTP_PASS=

WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

LINKEDIN_ACCESS_TOKEN=
LINKEDIN_ORGANIZATION_URN=

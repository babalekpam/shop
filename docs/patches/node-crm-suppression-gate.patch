diff --git a/server/db.ts b/server/db.ts
index 44cdba5..377d273 100644
--- a/server/db.ts
+++ b/server/db.ts
@@ -28,3 +28,17 @@ pool.on("connect", (client) => {
 
 export const db = drizzle(pool, { schema: { ...schema, ...schemaExtended } });
 export { pool };
+
+/**
+ * Rows from a raw SQL query, as an array.
+ *
+ * `db.execute()` on the node-postgres driver resolves to a pg `Result` object,
+ * NOT an array — `const [x] = await db.execute(...)` throws
+ * "TypeError: result is not iterable". The neon-http driver *does* return an
+ * array, so code written against one driver breaks silently on the other.
+ * This normalises both, and is the only safe way to read a raw query here.
+ */
+export async function rows<T = any>(query: Parameters<typeof db.execute>[0]): Promise<T[]> {
+  const res: any = await db.execute(query);
+  return Array.isArray(res) ? res : (res?.rows ?? []);
+}

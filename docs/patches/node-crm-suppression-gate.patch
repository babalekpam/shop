diff --git a/server/services/suppression.ts b/server/services/suppression.ts
new file mode 100644
index 0000000..ae36f04
--- /dev/null
+++ b/server/services/suppression.ts
@@ -0,0 +1,210 @@
+/**
+ * Suppression — the one place that decides whether an address may be emailed.
+ *
+ * Every send path in this codebase must go through `assertSendable` before it
+ * transmits. There are two of them today (the tracked-send route and the
+ * workflow engine's send_email action) and a gate in front of only one is worth
+ * nothing: the whole failure mode this prevents is a person who opted out on one
+ * path being contacted from the other.
+ *
+ * Unsubscribe tokens are HMACs, not rows. A stateless token works identically
+ * for both send paths, survives a restart, cannot be enumerated, and cannot be
+ * forged into someone else's address.
+ */
+import { db, rows } from "../db.js";
+import { sql } from "drizzle-orm";
+import { createHmac, timingSafeEqual } from "crypto";
+
+export type SuppressionChannel = "email";
+
+export class SuppressedRecipientError extends Error {
+  readonly code = "RECIPIENT_SUPPRESSED";
+  constructor(public readonly address: string) {
+    super(`${address} has opted out and cannot be contacted`);
+    this.name = "SuppressedRecipientError";
+  }
+}
+
+export class UnsubscribeSecretMissingError extends Error {
+  readonly code = "UNSUBSCRIBE_SECRET_MISSING";
+  constructor() {
+    super(
+      "UNSUBSCRIBE_SECRET (or JWT_SECRET) must be set before outreach email can be sent — " +
+      "without it the opt-out link cannot be signed."
+    );
+    this.name = "UnsubscribeSecretMissingError";
+  }
+}
+
+const APP_URL = process.env.APP_URL || "https://argilette.org";
+
+function secret(): string {
+  const s = process.env.UNSUBSCRIBE_SECRET || process.env.JWT_SECRET;
+  // Fail closed. Emitting an unsigned or randomly-keyed opt-out link is worse
+  // than not sending: the link breaks on the next restart and the recipient
+  // concludes the opt-out was ignored.
+  if (!s) throw new UnsubscribeSecretMissingError();
+  return s;
+}
+
+/** Addresses are compared case-insensitively — a suppression must not be escapable by capitalising. */
+export function normaliseAddress(address: string): string {
+  return address.trim().toLowerCase();
+}
+
+let tableReady: Promise<void> | null = null;
+function ensureTable(): Promise<void> {
+  if (!tableReady) {
+    tableReady = (async () => {
+      await db.execute(sql`
+        CREATE TABLE IF NOT EXISTS email_suppressions (
+          tenant_id varchar NOT NULL,
+          channel   text    NOT NULL DEFAULT 'email',
+          address   text    NOT NULL,
+          reason    text    NOT NULL,
+          source    text,
+          created_at timestamp NOT NULL DEFAULT now(),
+          PRIMARY KEY (tenant_id, channel, address)
+        )
+      `);
+      // Lawful basis lives on the record it justifies, enforced by a CHECK
+      // constraint rather than app-level validation, so a direct INSERT or a
+      // future second import path cannot bypass it.
+      await db.execute(sql`ALTER TABLE leads ADD COLUMN IF NOT EXISTS lawful_basis text`);
+      await db.execute(sql`ALTER TABLE leads ADD COLUMN IF NOT EXISTS lawful_basis_note text`);
+      await db.execute(sql`
+        DO $$ BEGIN
+          ALTER TABLE leads ADD CONSTRAINT leads_lawful_basis_check
+            CHECK (lawful_basis IS NULL OR lawful_basis IN
+              ('consent','contract','legitimate_interest','legal_obligation'));
+        EXCEPTION WHEN duplicate_object THEN NULL; END $$;
+      `);
+    })().catch((e) => { tableReady = null; throw e; });
+  }
+  return tableReady;
+}
+
+/** Idempotent by primary key — recording an opt-out twice is a no-op, never a duplicate row. */
+export async function suppress(opts: {
+  tenantId: string;
+  address: string;
+  reason: "unsubscribe" | "bounce" | "complaint" | "manual";
+  channel?: SuppressionChannel;
+  source?: string;
+}): Promise<void> {
+  await ensureTable();
+  const address = normaliseAddress(opts.address);
+  await db.execute(sql`
+    INSERT INTO email_suppressions (tenant_id, channel, address, reason, source)
+    VALUES (${opts.tenantId}, ${opts.channel || "email"}, ${address}, ${opts.reason}, ${opts.source || null})
+    ON CONFLICT (tenant_id, channel, address) DO NOTHING
+  `);
+}
+
+export async function isSuppressed(
+  tenantId: string,
+  address: string,
+  channel: SuppressionChannel = "email"
+): Promise<boolean> {
+  await ensureTable();
+  const hits = await rows<{ address: string }>(sql`
+    SELECT address FROM email_suppressions
+    WHERE tenant_id = ${tenantId} AND channel = ${channel} AND address = ${normaliseAddress(address)}
+    LIMIT 1
+  `);
+  return hits.length > 0;
+}
+
+/**
+ * Call this immediately before transmitting. Throws rather than returning false
+ * so that a caller who forgets to check the result still cannot send.
+ */
+export async function assertSendable(
+  tenantId: string,
+  address: string,
+  channel: SuppressionChannel = "email"
+): Promise<void> {
+  if (await isSuppressed(tenantId, address, channel)) {
+    throw new SuppressedRecipientError(normaliseAddress(address));
+  }
+}
+
+// ── Stateless one-click unsubscribe tokens ─────────────────────────────────
+
+function b64url(b: Buffer): string {
+  return b.toString("base64").replace(/\+/g, "-").replace(/\//g, "_").replace(/=+$/, "");
+}
+function unb64url(s: string): Buffer {
+  return Buffer.from(s.replace(/-/g, "+").replace(/_/g, "/"), "base64");
+}
+
+export function unsubscribeToken(tenantId: string, address: string, channel: SuppressionChannel = "email"): string {
+  const payload = `${tenantId}|${channel}|${normaliseAddress(address)}`;
+  const mac = createHmac("sha256", secret()).update(payload).digest();
+  return `${b64url(Buffer.from(payload, "utf8"))}.${b64url(mac)}`;
+}
+
+export function verifyUnsubscribeToken(
+  token: string
+): { tenantId: string; channel: SuppressionChannel; address: string } | null {
+  const dot = token.indexOf(".");
+  if (dot < 1) return null;
+  const payload = unb64url(token.slice(0, dot)).toString("utf8");
+  const given = unb64url(token.slice(dot + 1));
+
+  let expected: Buffer;
+  try { expected = createHmac("sha256", secret()).update(payload).digest(); }
+  catch { return null; }
+  if (given.length !== expected.length || !timingSafeEqual(given, expected)) return null;
+
+  const parts = payload.split("|");
+  if (parts.length !== 3) return null;
+  const [tenantId, channel, address] = parts as [string, string, string];
+  if (!tenantId || !address || channel !== "email") return null;
+  return { tenantId, channel, address };
+}
+
+export function unsubscribeUrl(tenantId: string, address: string): string {
+  return `${APP_URL}/track/unsubscribe/${unsubscribeToken(tenantId, address)}`;
+}
+
+/**
+ * RFC 8058 one-click headers. Mail clients surface a native "unsubscribe"
+ * button from these, which is what actually keeps complaint rates down —
+ * a footer link alone does not.
+ */
+export function unsubscribeHeaders(tenantId: string, address: string): Record<string, string> {
+  return {
+    "List-Unsubscribe": `<${unsubscribeUrl(tenantId, address)}>`,
+    "List-Unsubscribe-Post": "List-Unsubscribe=One-Click",
+  };
+}
+
+/**
+ * The opt-out footer. Defined once, here, so the tracked-send path and the
+ * workflow path cannot drift into showing recipients different things.
+ * Deliberately NOT click-tracked: the one action a recipient is unconditionally
+ * entitled to take must not depend on our redirect service being up.
+ */
+export function unsubscribeFooterHtml(unsubUrl: string): string {
+  return (
+    `<div style="margin-top:24px;padding-top:16px;border-top:1px solid #e2e8f0;` +
+    `font-size:12px;line-height:1.6;color:#64748b">` +
+    `Don't want these emails? <a href="${unsubUrl}" style="color:#64748b">Unsubscribe</a>.` +
+    `</div>`
+  );
+}
+
+// ── Lawful basis ───────────────────────────────────────────────────────────
+
+export const LAWFUL_BASES = ["consent", "contract", "legitimate_interest", "legal_obligation"] as const;
+export type LawfulBasis = (typeof LAWFUL_BASES)[number];
+
+export function isLawfulBasis(v: unknown): v is LawfulBasis {
+  return typeof v === "string" && (LAWFUL_BASES as readonly string[]).includes(v);
+}
+
+/** Run the consent migrations without performing a suppression lookup. */
+export async function ensureConsentSchema(): Promise<void> {
+  await ensureTable();
+}

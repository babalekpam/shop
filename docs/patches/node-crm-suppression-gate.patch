+// One-click unsubscribe (RFC 8058). Mail clients POST here from the native
+// unsubscribe button; people GET here from the footer link. Both must work, and
+// neither may require auth — the recipient has no account.
+async function applyUnsubscribe(token: string): Promise<boolean> {
+  const claim = verifyUnsubscribeToken(token);
+  if (!claim) return false;
+  await suppress({
+    tenantId: claim.tenantId,
+    address: claim.address,
+    reason: "unsubscribe",
+    channel: claim.channel,
+    source: "one-click",
+  });
+  return true;
+}
+
+const UNSUB_PAGE = (ok: boolean) => `<!doctype html><meta charset="utf-8">
+<meta name="viewport" content="width=device-width,initial-scale=1">
+<title>${ok ? "Unsubscribed" : "Link not valid"}</title>
+<body style="font-family:system-ui,-apple-system,Segoe UI,sans-serif;max-width:32rem;margin:15vh auto;padding:0 1.5rem;color:#1e293b;line-height:1.6">
+<h1 style="font-size:1.35rem;margin:0 0 .5rem">${ok ? "You've been unsubscribed" : "This link is not valid"}</h1>
+<p style="color:#64748b;margin:0">${ok
+  ? "You will not receive further emails from us. No further action is needed."
+  : "It may have been altered in transit. If you are still receiving email you did not ask for, reply to any message and we will remove you."}</p>
+</body>`;
+
+router.post("/unsubscribe/:token", async (req: Request, res: Response) => {
+  // RFC 8058 requires a 2xx with no body for the one-click POST.
+  try { await applyUnsubscribe(req.params.token); } catch { /* fall through */ }
+  res.status(200).end();
+});
+
+router.get("/unsubscribe/:token", async (req: Request, res: Response) => {
+  let ok = false;
+  try { ok = await applyUnsubscribe(req.params.token); } catch { ok = false; }
+  res.status(ok ? 200 : 400).type("html").send(UNSUB_PAGE(ok));
+});
+
